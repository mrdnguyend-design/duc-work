---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { LANGS, localePath, otherLang, type Lang } from '../../i18n/ui';
import { getPage } from '../../lib/content';

export const getStaticPaths: GetStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const entry = await getPage(lang, 'about');
if (!entry) throw new Error(`Missing page content: ${lang}/about.md`);
const { Content } = await render(entry);
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  altPath={localePath(otherLang(lang), '/about')}
>
  <div class="stack" style="margin-bottom: var(--space-5)">
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
  </div>
  <div class="prose"><Content /></div>
</Base>
