---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import EntryList from '../../../components/EntryList.astro';
import { LANGS, useT, localePath, otherLang, parseEntryId, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../lib/content';

export const getStaticPaths: GetStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const posts = await getPosts(lang);

const description = lang === 'vi'
  ? 'Ghi chép về retention marketing, vận hành ecommerce và dữ liệu đằng sau.'
  : 'Notes on retention marketing, ecommerce operations, and the data underneath.';
---

<Base
  lang={lang}
  title={t('writing.title')}
  description={description}
  altPath={localePath(otherLang(lang), '/writing')}
>
  <div class="stack" style="margin-bottom: var(--space-5)">
    <h1>{t('writing.title')}</h1>
    <p class="lede">{description}</p>
  </div>

  <EntryList
    lang={lang}
    empty={t('writing.empty')}
    items={posts.map((entry) => ({
      href: localePath(lang, `/writing/${parseEntryId(entry.id).slug}`),
      title: entry.data.title,
      description: entry.data.description,
      date: entry.data.pubDate,
      tags: entry.data.tags,
    }))}
  />
</Base>
