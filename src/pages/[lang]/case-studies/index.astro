---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import EntryList from '../../../components/EntryList.astro';
import { LANGS, useT, localePath, otherLang, parseEntryId, type Lang } from '../../../i18n/ui';
import { getCases } from '../../../lib/content';

export const getStaticPaths: GetStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const cases = await getCases(lang);

const description = lang === 'vi'
  ? 'Việc đã làm, kể cả phần không đẹp: bối cảnh, hành động, kết quả đo được.'
  : 'Work I have done, including the ugly parts: context, actions, measured outcome.';
---

<Base
  lang={lang}
  title={t('cases.title')}
  description={description}
  altPath={localePath(otherLang(lang), '/case-studies')}
>
  <div class="stack" style="margin-bottom: var(--space-5)">
    <h1>{t('cases.title')}</h1>
    <p class="lede">{description}</p>
  </div>

  <EntryList
    lang={lang}
    empty={t('cases.empty')}
    items={cases.map((entry) => ({
      href: localePath(lang, `/case-studies/${parseEntryId(entry.id).slug}`),
      title: entry.data.title,
      description: entry.data.description,
      outcome: entry.data.outcome,
      tags: entry.data.stack,
    }))}
  />
</Base>
